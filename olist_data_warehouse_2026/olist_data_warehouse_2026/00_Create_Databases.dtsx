  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\create_databases"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9D8CCD2D-C651-48CB-B996-78A89C045D2C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create_databases"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E6DDDC92-6659-44E0-9880-DD3BE83F9E0B}"
          SQLTask:SqlStatementSource="IF DB_ID(N'Olist_Staging') IS NULL&#xA;BEGIN&#xA;    CREATE DATABASE Olist_Staging;&#xA;END;&#xA;&#xA;IF DB_ID(N'Olist_DWH') IS NULL&#xA;BEGIN&#xA;    CREATE DATABASE Olist_DWH;&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\create_schema_dwh"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{12B50FFB-5979-4D11-9C62-F457F62F850C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create_schema_dwh"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E6DDDC92-6659-44E0-9880-DD3BE83F9E0B}"
          SQLTask:SqlStatementSource="&#xA;/* Olist Data Warehouse&#xA;   Database: Olist_DWH&#xA;   Purpose: Create Gold schema&#xA;*/&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.schemas&#xA;    WHERE name = 'gold'&#xA;)&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA gold');&#xA;END;&#xA;&#xA;PRINT 'Gold schema created or already exists.';&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\create_schema_stg"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{80C0D70D-FFCA-44E8-A694-E92E7D7B8461}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create_schema_stg"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E6DDDC92-6659-44E0-9880-DD3BE83F9E0B}"
          SQLTask:SqlStatementSource="&#xA;/* Olist Data Warehouse&#xA;   Database: Olist_Staging&#xA;   Purpose: Create Bronze and Silver schemas&#xA;*/&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.schemas&#xA;    WHERE name = 'bronze'&#xA;)&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA bronze');&#xA;END;&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.schemas&#xA;    WHERE name = 'silver'&#xA;)&#xA;BEGIN&#xA;    EXEC('CREATE SCHEMA silver');&#xA;END;&#xA;&#xA;PRINT 'Bronze and Silver schemas created or already exist.';&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\create_tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{93FF3F89-03F8-485A-856F-8939984A94A4}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="create_tables"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{E6DDDC92-6659-44E0-9880-DD3BE83F9E0B}"
          SQLTask:SqlStatementSource="USE Olist_Staging;&#xA;GO&#xA;&#xA;/* 1. Customers */&#xA;IF OBJECT_ID('bronze.olist_customers', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE bronze.olist_customers&#xA;    (&#xA;        customer_id             VARCHAR(100),&#xA;        customer_unique_id      VARCHAR(100),&#xA;        customer_zip_code_prefix VARCHAR(20),&#xA;        customer_city           VARCHAR(200),&#xA;        customer_state          VARCHAR(10)&#xA;    );&#xA;END;&#xA;&#xA;/* 2. Geolocation */&#xA;IF OBJECT_ID('bronze.olist_geolocation', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE bronze.olist_geolocation&#xA;    (&#xA;        geolocation_zip_code_prefix VARCHAR(20),&#xA;        geolocation_lat             VARCHAR(50),&#xA;        geolocation_lng             VARCHAR(50),&#xA;        geolocation_city            VARCHAR(200),&#xA;        geolocation_state           VARCHAR(10)&#xA;    );&#xA;END;&#xA;&#xA;/* 3. Order items */&#xA;IF OBJECT_ID('bronze.olist_order_items', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE bronze.olist_order_items&#xA;    (&#xA;        order_id            VARCHAR(100),&#xA;        order_item_id       VARCHAR(20),&#xA;        product_id          VARCHAR(100),&#xA;        seller_id           VARCHAR(100),&#xA;        shipping_limit_date VARCHAR(50),&#xA;        price               VARCHAR(50),&#xA;        freight_value       VARCHAR(50)&#xA;    );&#xA;END;&#xA;&#xA;/* 4. Order payments */&#xA;IF OBJECT_ID('bronze.olist_order_payments', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE bronze.olist_order_payments&#xA;    (&#xA;        order_id             VARCHAR(100),&#xA;        payment_sequential   VARCHAR(20),&#xA;        payment_type         VARCHAR(50),&#xA;        payment_installments VARCHAR(20),&#xA;        payment_value        VARCHAR(50)&#xA;    );&#xA;END;&#xA;&#xA;/* 5. Order reviews */&#xA;IF OBJECT_ID('bronze.olist_order_reviews', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE bronze.olist_order_reviews&#xA;    (&#xA;        review_id               VARCHAR(100),&#xA;        order_id                VARCHAR(100),&#xA;        review_score            VARCHAR(20),&#xA;        review_comment_title    VARCHAR(1000),&#xA;        review_comment_message  VARCHAR(MAX),&#xA;        review_creation_date    VARCHAR(50),&#xA;        review_answer_timestamp VARCHAR(50)&#xA;    );&#xA;END;&#xA;&#xA;/* 6. Orders */&#xA;IF OBJECT_ID('bronze.olist_orders', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE bronze.olist_orders&#xA;    (&#xA;        order_id                      VARCHAR(100),&#xA;        customer_id                   VARCHAR(100),&#xA;        order_status                  VARCHAR(50),&#xA;        order_purchase_timestamp      VARCHAR(50),&#xA;        order_approved_at             VARCHAR(50),&#xA;        order_delivered_carrier_date  VARCHAR(50),&#xA;        order_delivered_customer_date VARCHAR(50),&#xA;        order_estimated_delivery_date VARCHAR(50)&#xA;    );&#xA;END;&#xA;&#xA;/* 7. Products */&#xA;IF OBJECT_ID('bronze.olist_products', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE bronze.olist_products&#xA;    (&#xA;        product_id                   VARCHAR(100),&#xA;        product_category_name        VARCHAR(200),&#xA;        product_name_lenght          VARCHAR(20),&#xA;        product_description_lenght   VARCHAR(20),&#xA;        product_photos_qty           VARCHAR(20),&#xA;        product_weight_g             VARCHAR(30),&#xA;        product_length_cm             VARCHAR(30),&#xA;        product_height_cm             VARCHAR(30),&#xA;        product_width_cm              VARCHAR(30)&#xA;    );&#xA;END;&#xA;&#xA;/* 8. Sellers */&#xA;IF OBJECT_ID('bronze.olist_sellers', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE bronze.olist_sellers&#xA;    (&#xA;        seller_id              VARCHAR(100),&#xA;        seller_zip_code_prefix VARCHAR(20),&#xA;        seller_city             VARCHAR(200),&#xA;        seller_state            VARCHAR(10)&#xA;    );&#xA;END;&#xA;&#xA;/* 9. Product category translation */&#xA;IF OBJECT_ID('bronze.product_category_translation', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE bronze.product_category_translation&#xA;    (&#xA;        product_category_name         VARCHAR(200),&#xA;        product_category_name_english VARCHAR(200)&#xA;    );&#xA;END;&#xA;&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
