        <DTS:Executable
          DTS:refId="Package\Bronze - All Tables\Check Bronze Layer"
          DTS:CreationName="Microsoft.ExecuteSQLTask"
          DTS:Description="Execute SQL Task"
          DTS:DTSID="{6E24A73A-A6FB-4F6B-9D1D-DE4BA271D876}"
          DTS:ExecutableType="Microsoft.ExecuteSQLTask"
          DTS:LocaleID="-1"
          DTS:ObjectName="Check Bronze Layer"
          DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
          DTS:ThreadHint="0">
          <DTS:Variables />
          <DTS:ObjectData>
            <SQLTask:SqlTaskData
              SQLTask:Connection="{E6DDDC92-6659-44E0-9880-DD3BE83F9E0B}"
              SQLTask:SqlStatementSource="DECLARE @ShouldLoad INT;&#xA;&#xA;DECLARE @Counts TABLE&#xA;(&#xA;    TableName VARCHAR(100),&#xA;    ActualRows BIGINT,&#xA;    ExpectedRows BIGINT&#xA;);&#xA;&#xA;INSERT INTO @Counts&#xA;VALUES&#xA;('Customers',&#xA; (SELECT COUNT_BIG(*) FROM Olist_Staging.bronze.olist_customers),&#xA; 99441),&#xA;&#xA;('Geolocation',&#xA; (SELECT COUNT_BIG(*) FROM Olist_Staging.bronze.olist_geolocation),&#xA; 1000163),&#xA;&#xA;('Order Items',&#xA; (SELECT COUNT_BIG(*) FROM Olist_Staging.bronze.olist_order_items),&#xA; 112650),&#xA;&#xA;('Payments',&#xA; (SELECT COUNT_BIG(*) FROM Olist_Staging.bronze.olist_order_payments),&#xA; 103886),&#xA;&#xA;('Reviews',&#xA; (SELECT COUNT_BIG(*) FROM Olist_Staging.bronze.olist_order_reviews),&#xA; 99224),&#xA;&#xA;('Orders',&#xA; (SELECT COUNT_BIG(*) FROM Olist_Staging.bronze.olist_orders),&#xA; 99441),&#xA;&#xA;('Products',&#xA; (SELECT COUNT_BIG(*) FROM Olist_Staging.bronze.olist_products),&#xA; 32951),&#xA;&#xA;('Sellers',&#xA; (SELECT COUNT_BIG(*) FROM Olist_Staging.bronze.olist_sellers),&#xA; 3095),&#xA;&#xA;('Category Translation',&#xA; (SELECT COUNT_BIG(*) FROM Olist_Staging.bronze.product_category_translation),&#xA; 71);&#xA;&#xA;IF (SELECT COUNT(*) FROM @Counts&#xA;    WHERE ActualRows = ExpectedRows) = 9&#xA;BEGIN&#xA;    SET @ShouldLoad = 0;&#xA;END&#xA;ELSE IF (SELECT COUNT(*) FROM @Counts&#xA;         WHERE ActualRows = 0) = 9&#xA;BEGIN&#xA;    SET @ShouldLoad = 1;&#xA;END&#xA;ELSE&#xA;BEGIN&#xA;    THROW 51002,&#xA;        'Bronze layer contains unexpected or partial data. Loading stopped.',&#xA;        1;&#xA;END;&#xA;&#xA;SELECT @ShouldLoad AS ShouldLoad;"
              SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
              <SQLTask:ResultBinding
                SQLTask:ResultName="0"
                SQLTask:DtsVariableName="User::ShouldLoadBronzeCustomers" />
            </SQLTask:SqlTaskData>
          </DTS:ObjectData>
        </DTS:Executable>
